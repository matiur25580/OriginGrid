{
  "name": "origingrid",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise product provenance and Digital Product Passport platform",
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace @origingrid/api",
    "dev:web": "npm run dev --workspace @origingrid/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}